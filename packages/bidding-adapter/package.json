{
  "name": "@engram/bidding-adapter",
  "version": "0.0.0",
  "private": true,
  "description": "Engram 首个领域适配器 — 经 Consumer SPI 单调收紧，不反向依赖内核",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@engram/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.0",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.21.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
